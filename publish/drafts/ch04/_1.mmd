flowchart TD
    subgraph Single["单步闭环"]
        S1[输入] --> S2[路由]
        S2 --> S3[单次执行]
        S3 --> S4[输出]
    end

    subgraph Multi["多步执行"]
        M1[输入] --> M2[路由到 workflow]
